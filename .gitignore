.DS_Store
*.swp

# Xcode
build/
DerivedData/
xcuserdata/
*.xcuserdatad
.swiftpm/
Pastry.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Claude Code's working directories, including its git worktrees
.claude/

# Release artifacts, which the release workflow writes to the repository root
*.dmg

# Signing material. These never belong in the repository — they go to GitHub
# Actions secrets. Ignored so that an export left here by accident cannot be
# committed by a careless `git add -A`.
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
# .provisionprofile is the macOS spelling of .mobileprovision, and the one
# this project actually uses. *.pem and *.key are what `asc certificates
# create --generate-csr` leaves behind: an unencrypted private key.
*.provisionprofile
*.pem
*.key
